# Fire & Smoke Detection System Environment Configuration
# Copy this file to .env to override defaults

APP_NAME="AI Fire & Smoke Detection System"
APP_ENV="development"
DEBUG=True

# Model Settings
MODEL_PATH="models/fire_smoke.pt"
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45
INFERENCE_IMG_SIZE=640
FORCE_CPU=False

# Camera & Video Settings
DEFAULT_CAMERA_INDEX=0
VIDEO_PROCESS_FRAME_INTERVAL=2
MAX_UPLOAD_SIZE_MB=150

# Alert Settings
ALERT_COOLDOWN_SECONDS=5.0
TEMPORAL_WINDOW_FRAMES=5
TEMPORAL_CONFIRMATION_MIN_DETECTIONS=3
ENABLE_AUDIO_ALERTS=True

# Database & Storage
DATABASE_PATH="database/detection_events.db"
SNAPSHOTS_DIR="outputs/snapshots"
PROCESSED_VIDEOS_DIR="outputs/processed_videos"
REPORTS_DIR="outputs/reports"
